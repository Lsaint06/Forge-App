{
  "expo": {
    "name": "FORGE",
    "slug": "forge-fitness",
    "scheme": "forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lsaint06.forge",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lsaint06.forge"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101216",
          "image": "./assets/splash/launch-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101216",
            "image": "./assets/splash/launch-mark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": ["ios", "android"]
  }
}

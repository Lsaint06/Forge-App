  "id": "forge-muscle-advanced-5-day",
  "version": 1,
  "status": "draft",
  "name": "Advanced Muscle Building · 5 Days",
  "summary": "Forge Muscle Building V3 (A-M5): five hypertrophy sessions a week for advanced lifters.",
  "description": "Forge Muscle Building V3 program A-M5. Split: Upper / Lower / Push / Pull / Legs. Sessions: Upper A (Chest & Back); Lower A (Quad Emphasis); Push (Chest, Shoulders & Triceps); Pull (Back & Biceps); Lower B (Hamstrings & Glutes). Listed sets are working sets; warm-up sets are separate. Unilateral prescriptions are per side. Start with about 2–4 minutes of rest after compound exercises and 1–2 minutes after isolation work, and rest longer whenever you need to keep your sets productive.",
  "experience": "Advanced",
  "goal": "Muscle Building",
  "daysPerWeek": 5,
  "equipment": ["Barbell", "Cable", "Dumbbell", "Machine", "Smith machine"],
  "weeklyPattern": [
    "train",
    "train",
    "train",
    "rest",
    "train",
    "train",
    "rest"
  ],
  "progression": "Ongoing autoregulated progression at about 1–3 RIR. Each exercise progresses from its own recorded performance. Load rises when every working set reaches the top of the range at the target effort, or when every set is clearly easier than the target. Effort harder than the target holds the load. Challenging isolation work is fine, but failure is never required. Listed sets are working sets; warm-up sets are separate. Keep technique and range of motion consistent from session to session. Add load only when your logged sets earn it, and never because a week has passed. Missing effort data never counts as reaching the target. One missed session keeps the load, and repeated misses suggest a modest reduction. Weekly sets never increase automatically, and training to failure is never required. When fatigue builds up or performance stalls, choose a lower-fatigue session (about 35% fewer working sets at 3–4 RIR). There are no scheduled deloads.",
  "progressionModel": "autoregulated",
  "lowerFatigue": {
    "setReduction": 0.35,
    "rir": {
      "min": 3,
      "max": 4
    }
  },

  "status": "draft",
  "name": "Intermediate Muscle Building · 5 Days",
  "summary": "Forge Muscle Building V3 (I-M5): five hypertrophy sessions a week for intermediate lifters.",
  "description": "Forge Muscle Building V3 program I-M5. Split: Push / Pull / Legs / Upper / Lower. Sessions: Push; Pull; Legs; Upper; Lower. Listed sets are working sets; warm-up sets are separate. Unilateral prescriptions are per side. Start with about 2–3 minutes of rest after compound exercises and 1–2 minutes after isolation work, and rest longer whenever you need to keep your sets productive.",
  "experience": "Intermediate",
  "goal": "Muscle Building",
  "daysPerWeek": 5,
  "equipment": ["Barbell", "Cable", "Dumbbell", "Machine"],
  "weeklyPattern": [
    "train",
    "train",
    "train",
    "rest",
    "train",
    "train",
    "rest"
  ],
  "progression": "Ongoing double progression at about 1–3 RIR, driven by recorded performance. Build reps within each range. When every working set reaches the top of the range at the target effort, with effort logged, add one small load increment and build back up. Two sessions at the same load without added reps flag a possible stall. Listed sets are working sets; warm-up sets are separate. Keep technique and range of motion consistent from session to session. Add load only when your logged sets earn it, and never because a week has passed. Missing effort data never counts as reaching the target. One missed session keeps the load, and repeated misses suggest a modest reduction. Weekly sets never increase automatically, and training to failure is never required. When fatigue builds up or performance stalls, choose a lower-fatigue session (about 35% fewer working sets at 3–4 RIR). There are no scheduled deloads.",
  "progressionModel": "double-progression",
  "lowerFatigue": {
    "setReduction": 0.35,
    "rir": {
      "min": 3,
      "max": 4
    }
  },

# Public client configuration, never a service-role secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Forge's dedicated support address, shown on the recovery screen.
# Leave empty until a real address exists; nothing is shown without it.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional, prepared for separate development and production Supabase projects
# (Phase 7.8E). Leave both empty while Forge has one project: nothing changes.
# Once set, this build connects only to https://<ref>.supabase.co and treats
# any other address as misconfigured. FORGE_ENV: development or production.
EXPO_PUBLIC_FORGE_ENV=
EXPO_PUBLIC_SUPABASE_PROJECT_REF=

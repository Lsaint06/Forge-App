# FORGE Dev (the development build) and the development Supabase project
# (Phase 8). Copy this file to .env.forge-dev (never committed) and fill it in
# from the DEVELOPMENT project's dashboard (Project Settings → API keys and
# Data API). Read only by `npm run start:dev`, `npm run dev:check` and
# `npm run dev:verify-stage3`; `npm start` (Expo Go) keeps reading .env.
# Public client values only: never a secret or service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://<development-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_FORGE_ENV=development
EXPO_PUBLIC_SUPABASE_PROJECT_REF=

# Optional, as in .env.example.
EXPO_PUBLIC_SUPPORT_EMAIL=

# FORGE Dev (the development build) and the development Supabase project
# (Phase 8). Copy this file to .env.forge-dev (never committed) and fill it in
# from the DEVELOPMENT project's dashboard (Project Settings → API keys and
# Data API). Read only by `npm run start:dev`, `npm run dev:check`,
# `npm run dev:verify-stage3` and `npm run dev:ios -- --release`; `npm start`
# (Expo Go) keeps reading .env.
# Public client values only: never a secret or service-role key.
# On Windows, edit it in an editor: Windows PowerShell's `>` writes UTF-16,
# which the tools can't read.
EXPO_PUBLIC_SUPABASE_URL=https://<development-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_FORGE_ENV=development
EXPO_PUBLIC_SUPABASE_PROJECT_REF=

# Optional, as in .env.example.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Optional: Forge Premium in development builds only (Phase 9.3,
# docs/SUBSCRIPTIONS.md). Leave all empty and nothing changes; set
# EXPO_PUBLIC_FORGE_MEMBERSHIP=development to show the paywall after the
# Forge Path reveal. RevenueCat's PUBLIC SDK keys only, never a secret (sk_)
# key: appl_ for FORGE Dev's App Store app (sandbox purchases), test_ for
# RevenueCat's Test Store (Expo Go and debug builds; simulated, sells nothing).
EXPO_PUBLIC_FORGE_MEMBERSHIP=
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=
# The paywall's Terms of Use and Privacy Policy (founder decision F15), HTTPS.
EXPO_PUBLIC_TERMS_OF_USE_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
